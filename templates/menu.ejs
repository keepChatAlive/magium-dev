<div class="main-menu">
    <div class="response">
        <button
            data-icon="play"
            hx-post="/"
            hx-ext="submitcurrentstate"
            hx-target="#content"
            hx-swap="innerHTML"
            hx-push-url="true"
        > 
            <%= menuBackToGameText %>
        </button>
    </div>
    <div class="response">
        <button
            data-icon="restart"
            hx-post="/"
            hx-ext="submitcurrentstate"
            hx-on::before-request="clearState()"
            hx-target="#content"
            hx-swap="innerHTML"
            hx-push-url="true"
        > 
            <%= menuNewGameText %>
        </button>
    </div>
    <div class="response">
        <button
            data-icon="checkpoint"
            hx-post="/"
            hx-ext="submitcurrentstate"
            hx-on::before-request="loadGameFromLocalStorage('checkpoint')"
            hx-target="#content"
            hx-swap="innerHTML"
            hx-push-url="true"
        > 
            <%= menuLoadCheckpointText %>
        </button>
    </div>
    <div class="response">
        <button
            data-icon="save"
            hx-post="/saves/0"
            hx-target="#content"
            hx-swap="innerHTML"
            hx-push-url="true"
            hx-ext="submitlocalstorage"
        > 
            <%= menuSaveLoadText %>
        </button>
    </div>
    <div class="response">
        <button
            data-icon="achievement"
            hx-get="/achievements"
            hx-target="#content"
            hx-swap="innerHTML"
            hx-push-url="true"
        > 
            <%= menuAchievementsText %>
        </button>
    </div>
    <div class="response">
        <button
            data-icon="settings"
            hx-post="/settings"
            hx-ext="submittheme"
            hx-target="#content"
            hx-swap="innerHTML"
            hx-push-url="true"
        > 
            <%= menuSettingsText %>
        </button>
    </div>
    <div class="response">
        <button
            data-icon="info"
            hx-get="/about"
            hx-target="#content"
            hx-swap="innerHTML"
            hx-push-url="true"
        > 
            <%= menuAboutText %>
        </button>
    </div>
</div>
<div style="display:none">
    <h2 class="header-title" id="header" hx-swap-oob="true">
        <%= menuHeaderText %>
    </h2>
</div>
